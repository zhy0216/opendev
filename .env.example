# Database
DATABASE_URL=postgresql://user:password@localhost:5432/repo

# Server
NODE_ENV=development
SERVER_PORT=3000

# Logging
# Log levels: trace, debug, info, warn, error, fatal
# If not set, defaults based on NODE_ENV: development=debug, production=info, test=error
# LOG_LEVEL=debug

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# Trigger.dev (Background Jobs)
# Get these from https://cloud.trigger.dev after creating a project
TRIGGER_SECRET_KEY=tr_dev_your_secret_key_here
TRIGGER_PROJECT_REF=proj_your_project_ref_here
