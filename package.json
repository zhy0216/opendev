{
  "name": "repo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "dotenv -- turbo run dev",
    "build": "dotenv -- turbo run build",
    "lint": "dotenv -- turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "dotenv -- turbo run db:generate --filter=@repo/db",
    "db:migrate": "dotenv -- turbo run db:migrate --filter=@repo/db",
    "db:studio": "dotenv -- turbo run db:studio --filter=@repo/db",
    "clean": "turbo run clean",
    "trigger:dev": "dotenv -- turbo run trigger:dev --filter=@repo/jobs",
    "trigger:deploy": "dotenv -- turbo run trigger:deploy --filter=@repo/jobs"
  },
  "packageManager": "bun@1.3.5",
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.7.2",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.9.3",
    "@biomejs/biome": "^2.3.5",
    "lefthook": "^2.0.3"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2"
  }
}
