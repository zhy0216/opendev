    "@repo/bootstrap": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/routes": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/di": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/use-case": "workspace:*",
    "@repo/repository": "workspace:*",
    "@repo/service": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
